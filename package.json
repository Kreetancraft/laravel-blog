    "description": "Editor assets for kreetancraft/laravel-blog. Built output is committed; hosts do not need to run this.",
    "scripts": {
        "build": "esbuild resources/js/rich-text.js --bundle --format=iife --minify --outfile=resources/dist/blog-editor.js"
    },
    "devDependencies": {
        "esbuild": "^0.25.0"
    },
    "dependencies": {
        "@tiptap/core": "^3.27.1",
        "@tiptap/starter-kit": "^3.27.1",
        "@tiptap/extension-text-style": "^3.27.1",
        "@tiptap/extension-color": "^3.27.1",
        "@tiptap/extension-highlight": "^3.27.1",
        "@tiptap/extension-image": "^3.27.1",
        "@tiptap/extension-text-align": "^3.27.1",
        "@tiptap/extension-placeholder": "^3.27.1",
        "@tiptap/extension-table": "^3.27.1",
        "@tiptap/extension-list": "^3.27.1",
        "@tiptap/extension-character-count": "^3.27.1",
        "@tiptap/extension-youtube": "^3.27.1"
    }
}
